# Скопируйте в .env и заполните (REQ-INST-002). Файл .env не попадает в Git (REQ-SEC-008).

# База данных
POSTGRES_USER=shopper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopper

# API-сервер
API_PORT=8080
LOG_LEVEL=info
# Бюджет запросов API к Steam за 5 минут (ADR-0006)
API_STEAM_QUOTA=30

# Фоновый обработчик: период опроса от 1h до 24h (REQ-FUNC-017)
POLL_INTERVAL=3h

# Тестовый режим: вместо Steam имитированный источник (REQ-FUNC-030)
TEST_MODE=false

# Резервные копии
BACKUP_KEEP=7
BACKUP_INTERVAL=86400

# Веб-клиент (Caddy). :80 — локально по HTTP; доменное имя — автоматический HTTPS.
SITE_ADDRESS=:80
# Внешний адрес сайта для ссылок в письмах
APP_BASE_URL=http://localhost

# Почта (REQ-INT-010). SMTP_TLS: starttls (порт 587) | tls (порт 465) | none.
# Для демонстрации с Mailpit (docker compose --profile test): SMTP_HOST=mailpit,
# SMTP_PORT=1025, SMTP_TLS=none. Пустой SMTP_HOST — письма ждут в очереди.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Охотник за скидками <noreply@example.com>
SMTP_TLS=starttls

# Telegram-бот (REQ-INT-012): токен от @BotFather и имя бота без @.
# Пустые значения — функции Telegram выключены, остальное работает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Ключи появятся в следующих итерациях:
# ITAD_API_KEY=          (F-14)
# STEAM_WEB_API_KEY=     (F-13)
