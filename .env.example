# Скопируйте в .env и заполните (REQ-INST-002). Файл .env не попадает в Git (REQ-SEC-008).

# База данных
POSTGRES_USER=shopper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopper

# API-сервер
API_PORT=8080
LOG_LEVEL=info
# Бюджет запросов API к Steam за 5 минут (ADR-0006)
API_STEAM_QUOTA=30

# Фоновый обработчик: период опроса от 1h до 24h (REQ-FUNC-017)
POLL_INTERVAL=3h

# Тестовый режим: вместо Steam имитированный источник (REQ-FUNC-030)
TEST_MODE=false

# Временный пользователь до появления регистрации (F-02, итерация 2)
DEV_USER_EMAIL=demo@example.com

# Резервные копии
BACKUP_KEEP=7
BACKUP_INTERVAL=86400

# Ключи появятся в следующих итерациях:
# ITAD_API_KEY=          (F-14)
# STEAM_WEB_API_KEY=     (F-13)
# SMTP_HOST= SMTP_USER= SMTP_PASSWORD=   (F-03)
# TELEGRAM_BOT_TOKEN=    (F-22)
