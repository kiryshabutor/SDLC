' Реализовано в итерации 1 (F-05), internal/app/wishlist.go.
!include _style.iuml
mainframe **activity** AD-02b Добавление игры: сохранение

start
:Запросить\nappdetails;
if () then ([ошибка\nSteam])
  :Ответ\n503;
  stop
elseif () then ([игра не\nнайдена])
  :Ответ\n404;
  stop
else ([найдена])
endif
