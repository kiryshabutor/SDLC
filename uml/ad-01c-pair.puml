@startuml ad-01c-pair
' AD-01c. Обработка одной пары (игра, регион) в транзакции.
' Уточняет DV-010 и SM-01b.
!include _style.iuml

start
:Обновить\nprice_state;
if (Цена\nизменилась?) then (да)
  :Записать\nprice_history,\nпересчитать\nминимум;
else (нет)
endif
if (Продаётся и\nусловие выполнено\nдля новой цены?) then (да)
  :Создать\nуведомление;
else (нет)
endif
:Зафиксировать\nтранзакцию;
stop
@enduml
