@startuml sm-01b-tracked
' SM-01b. Вложенные состояния «Отслеживается»: защита
' от повторных уведомлений (REQ-FUNC-026, DV-010).
!include _style.iuml
hide empty description

state Отслеживается {
  [*] --> Ожидание
  Ожидание --> Уведомлено : [условие\nвыполнено]\n/ уведомить
  Уведомлено --> Ожидание : [условие не\nвыполнено]
  Уведомлено --> Уведомлено : [новая цена,\nусловие\nвыполнено]\n/ уведомить
  Ожидание : entry / last_notified\n_price := NULL
  Уведомлено : entry / last_notified\n_price := цена
}
note bottom of Отслеживается
  Все переходы происходят
  по событию «цена получена».
  Та же цена ничего не меняет.
end note
@enduml
