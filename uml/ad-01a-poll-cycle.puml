@startuml ad-01a-poll-cycle
' AD-01a. Цикл опроса цен (UC-12 с включённым UC-13).
' Уточняет DV-007. Обработка пакета вынесена в AD-01b.
!include _style.iuml

start
:Таймер POLL_INTERVAL\nили задание check / test;
if (Блокировка занята\nи запуск плановый?) then (да:\nпропустить)
  stop
else (нет)
endif
:Захватить блокировку,\nсоздать poll_cycles,\nвыбрать пары;
while (Есть необработанный\nпакет пар?) is (да)
  :Обработать пакет\n(AD-01b);
endwhile (нет)
:Дайджесты в outbox,\nстатистика,\nснять блокировку;
stop
@enduml
