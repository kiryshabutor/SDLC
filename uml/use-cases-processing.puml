@startuml use-cases-processing
' Модель прецедентов R1, диаграмма 2 из 2: отслеживание цен и уведомления.
' Описания актёров и прецедентов: docs/use-case-model.md
!include _style.iuml
left to right direction
skinparam packageStyle rectangle

actor "Пользователь" as User
actor "Время" as Time <<таймер>>
actor "Разработчик" as Dev
actor "Steam" as Steam <<система>>
actor "Канал доставки" as Channel <<система>>
actor "Почтовый сервер" as Mail <<система>>
actor "Telegram" as TG <<система>>

rectangle "Охотник за скидками в Steam" {
  usecase "UC-10 Проверить\nцены сейчас" as UC10
  usecase "UC-16 Сымитировать\nизменение цены" as UC16
  usecase "UC-12 Выполнить\nцикл опроса цен" as UC12
  usecase "UC-13 Уведомить\nо скидке" as UC13
  usecase "UC-14 Просмотреть\nцентр уведомлений" as UC14
}

User --> UC10
User --> UC14
Dev --> UC16
Time ---> UC12

UC10 ..> UC12 : <<include>>
UC16 ..> UC12 : <<include>>
UC12 ..> UC13 : <<include>>

UC12 ---> Steam
UC13 --> Channel
Channel <|-- Mail
Channel <|-- TG
@enduml
