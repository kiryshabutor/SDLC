@startuml sequence-add-game
' SD-01. Добавление игры по ссылке или appid (UC-05). Реализовано в итерации 1 (F-05).
!include _style.iuml
autonumber
hide footbox

actor "Пользователь" as U
participant "SPA" as C
participant "httpapi" as H
participant "app.Wishlist" as W
participant "domain" as D
participant "source.GameSearch\n(steam)" as S
participant "Steam Store API" as ST
database "PostgreSQL" as DB

U -> C : ссылка или appid
C -> H : POST /api/v1/wishlist {"ref": "…"}
H -> W : Add(ctx, userID, ref)
W -> D : ParseAppRef(ref)
D --> W : appid
alt ввод не распознан
  W --> H : ErrInvalidAppRef
  H --> C : 400 invalid_app_ref
else appid распознан
  W -> DB : SELECT 1 FROM wishlist_items\nWHERE user_id, appid
  alt уже в вишлисте
    W --> H : ErrAlreadyInWishlist
    H --> C : 409 already_in_wishlist
  else новая игра
    W -> S : Details(region, appid)
    S -> ST : GET /api/appdetails?appids=…&cc=…
    ST --> S : JSON
    alt success = false
      S --> W : ErrNotFound
      W --> H : ErrGameNotFound
      H --> C : 404 game_not_found
    else игра найдена
      S --> W : Game, Price
      W -> DB : BEGIN; UPSERT games;\nUPSERT price_state; INSERT price_history;\nINSERT wishlist_items; COMMIT
      W --> H : WishlistItem
      H --> C : 201 {game, price, condition: any}
      C --> U : игра в вишлисте
    end
  end
end
@enduml
