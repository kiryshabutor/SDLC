@startuml sm-02-outbox
' SM-02. Запись outbox: письмо или сообщение Telegram.
' Уточняет DV-013, ADR-0007, ADR-0009.
!include _style.iuml
hide empty description

[*] --> Ожидает : создана\n/ attempts := 0
Ожидает --> Отправляется : тик 10 с\n[срок попытки\nнаступил]
Отправляется --> Отправлена : успех
Отправляется --> Ожидает : ошибка\n[attempts < 3]\n/ +5 мин
Отправляется --> Ошибка : ошибка\n[attempts = 3]
Отправляется --> Отменена : 403\nTelegram
Ожидает --> Отменена : канал\nотключён
Отправлена --> [*]
Ошибка --> [*]
Отменена --> [*]
@enduml
