@startuml state-wishlist-item
' SM-01. Состояния элемента вишлиста относительно уведомлений. Уточняет DV-011.
!include _style.iuml
hide empty description

[*] --> Отслеживается : добавлена в вишлист\n/ условие «любая скидка»

state Отслеживается {
  [*] --> Ожидание
  Ожидание --> Уведомлено : цена получена [условие выполнено]\n/ создать уведомление
  Уведомлено --> Уведомлено : цена получена [условие выполнено,\nцена изменилась] / новое уведомление
  Уведомлено --> Ожидание : цена получена [условие не выполнено]\n/ last_notified_price := NULL
  Ожидание : entry / last_notified_price = NULL
  Ожидание : цена получена [условие не выполнено] / ничего
  Уведомлено : entry / last_notified_price := итоговая цена
  Уведомлено : цена получена [та же цена] / ничего
}

Отслеживается --> Недоступна : цена получена\n[unavailable, free, unreleased]
Недоступна --> Отслеживается : цена получена [игра продаётся]
Недоступна : условия не проверяются

Отслеживается --> Отслеживается : смена региона\n/ below(X) := any, сброс last_notified_price
Отслеживается --> [*] : удалена из вишлиста\nили удалён аккаунт
Недоступна --> [*] : удалена из вишлиста\nили удалён аккаунт
@enduml
