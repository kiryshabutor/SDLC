@startuml uc-2-games
' Модель прецедентов R1, диаграмма 2 из 7: добавление игр
' Описания актёров и прецедентов: docs/use-case-model.md
!include _style.iuml
top to bottom direction
skinparam packageStyle rectangle

actor "Пользо-\nватель" as User
actor "Steam" as Steam <<система>>

rectangle "Система" {
  usecase "UC-04\nНайти игру" as UC04
  usecase "UC-06\nИмпортировать\nвишлист Steam" as UC06
  usecase "UC-05\nДобавить игру\nв вишлист" as UC05
}

User --> UC04
User --> UC06
User ---> UC05
UC04 <.. UC05 : <<extend>>
UC06 ..> UC05 : <<include>>
UC05 ---> Steam
UC04 ----> Steam
UC06 ----> Steam
@enduml
