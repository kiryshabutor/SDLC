@startuml uc-2-games
' Модель прецедентов R1, диаграмма 2 из 7: добавление игр
' Описания актёров и прецедентов: docs/use-case-model.md
!include _style.iuml
mainframe **uc** Прецеденты (2/7): Добавление игр
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 60

actor "Пользо-\nватель" as User
actor "Steam" as Steam <<система>>

rectangle "Система" {
  usecase "UC-04\nНайти игру" as UC04
  usecase "UC-05\nДобавить игру\nв вишлист" as UC05
  usecase "UC-06\nИмпортировать\nвишлист Steam" as UC06
}

User --> UC04
User --> UC05
User --> UC06
UC04 <.[norank]. UC05 : <<extend>>
UC06 .[norank].> UC05 : <<include>>
UC04 --> Steam
UC05 --> Steam
UC06 --> Steam
@enduml
